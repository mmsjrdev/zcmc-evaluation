# Uploaded files are never served directly. PHP scripts read them and send
# them only to people who are allowed to see them.

# 1) Deny all web access.
# Apache 2.4 and newer:
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
# Apache 2.2 and older:
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# 2) Even if access were ever opened, never run PHP from this folder.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|phar|pl|py|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
Options -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
